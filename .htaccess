Options +SymLinksIfOwnerMatch -MultiViews
<IfModule mod_rewrite.c>
RewriteEngine On

#If your website is installed in a subfolder, change the line below to reflect the path to the subfolder.
#e.g. for http://www.example.com/subdomain1/subdomain2/ make it RewriteBase /subdomain1/subdomain2
RewriteBase /

#If you wish to use a custom 404 page, place a file named 404.php in your website's root and uncomment the line below.
#If your website is installed in a subfolder, change the line below to reflect the path to the subfolder.
#e.g. for http://www.example.com/subdomain1/subdomain2/ make it ErrorDocument 404 /subdomain1/subdomain2/404.php
#ErrorDocument 404 /404.php

#If your site begins with 'www', uncomment the following two lines
#RewriteCond %{HTTP_HOST} !^www\.
#RewriteRule ^(.*)$ http://www.%{HTTP_HOST}/$1 [R=301,L]


#DO NOT EDIT BELOW THIS

RewriteRule ^index.php$ "" [R=301,L,QSA]

RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule . - [L]

#blocks/frame/thinbar.php
RewriteRule ^blocks/frame/thinbar$ "$0/" [R=301,L,QSA]
RewriteRule ^blocks/frame/thinbar/$ blocks/frame/thinbar.php [L,QSA]
RewriteRule ^blocks/frame/thinbar/.*?([^\.\/]*)\.html$ blocks/frame/thinbar.php?pname=$1 [L,QSA]
RewriteRule ^blocks/frame/thinbar/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ blocks/frame/thinbar.php?d=$1$2$3 [L,QSA]
RewriteRule ^blocks/frame/thinbar/[^\.]*?([^/\.]*)/$ blocks/frame/thinbar.php?fname=$1 [L,QSA]
RewriteRule ^blocks/frame/thinbar/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#blocks/frame/navbar.php
RewriteRule ^blocks/frame/navbar$ "$0/" [R=301,L,QSA]
RewriteRule ^blocks/frame/navbar/$ blocks/frame/navbar.php [L,QSA]
RewriteRule ^blocks/frame/navbar/.*?([^\.\/]*)\.html$ blocks/frame/navbar.php?pname=$1 [L,QSA]
RewriteRule ^blocks/frame/navbar/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ blocks/frame/navbar.php?d=$1$2$3 [L,QSA]
RewriteRule ^blocks/frame/navbar/[^\.]*?([^/\.]*)/$ blocks/frame/navbar.php?fname=$1 [L,QSA]
RewriteRule ^blocks/frame/navbar/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#blocks/frame/hero.php
RewriteRule ^blocks/frame/hero$ "$0/" [R=301,L,QSA]
RewriteRule ^blocks/frame/hero/$ blocks/frame/hero.php [L,QSA]
RewriteRule ^blocks/frame/hero/.*?([^\.\/]*)\.html$ blocks/frame/hero.php?pname=$1 [L,QSA]
RewriteRule ^blocks/frame/hero/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ blocks/frame/hero.php?d=$1$2$3 [L,QSA]
RewriteRule ^blocks/frame/hero/[^\.]*?([^/\.]*)/$ blocks/frame/hero.php?fname=$1 [L,QSA]
RewriteRule ^blocks/frame/hero/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#blocks/frame/footer.php
RewriteRule ^blocks/frame/footer$ "$0/" [R=301,L,QSA]
RewriteRule ^blocks/frame/footer/$ blocks/frame/footer.php [L,QSA]
RewriteRule ^blocks/frame/footer/.*?([^\.\/]*)\.html$ blocks/frame/footer.php?pname=$1 [L,QSA]
RewriteRule ^blocks/frame/footer/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ blocks/frame/footer.php?d=$1$2$3 [L,QSA]
RewriteRule ^blocks/frame/footer/[^\.]*?([^/\.]*)/$ blocks/frame/footer.php?fname=$1 [L,QSA]
RewriteRule ^blocks/frame/footer/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#blocks/banner/transitions.php
RewriteRule ^blocks/banner/transitions$ "$0/" [R=301,L,QSA]
RewriteRule ^blocks/banner/transitions/$ blocks/banner/transitions.php [L,QSA]
RewriteRule ^blocks/banner/transitions/.*?([^\.\/]*)\.html$ blocks/banner/transitions.php?pname=$1 [L,QSA]
RewriteRule ^blocks/banner/transitions/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ blocks/banner/transitions.php?d=$1$2$3 [L,QSA]
RewriteRule ^blocks/banner/transitions/[^\.]*?([^/\.]*)/$ blocks/banner/transitions.php?fname=$1 [L,QSA]
RewriteRule ^blocks/banner/transitions/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#assets/css/user.php
RewriteRule ^assets/css/user$ "$0/" [R=301,L,QSA]
RewriteRule ^assets/css/user/$ assets/css/user.php [L,QSA]
RewriteRule ^assets/css/user/.*?([^\.\/]*)\.html$ assets/css/user.php?pname=$1 [L,QSA]
RewriteRule ^assets/css/user/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ assets/css/user.php?d=$1$2$3 [L,QSA]
RewriteRule ^assets/css/user/[^\.]*?([^/\.]*)/$ assets/css/user.php?fname=$1 [L,QSA]
RewriteRule ^assets/css/user/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#bmenu/service.php
RewriteRule ^bmenu/service$ "$0/" [R=301,L,QSA]
RewriteRule ^bmenu/service/$ bmenu/service.php [L,QSA]
RewriteRule ^bmenu/service/.*?([^\.\/]*)\.html$ bmenu/service.php?pname=$1 [L,QSA]
RewriteRule ^bmenu/service/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ bmenu/service.php?d=$1$2$3 [L,QSA]
RewriteRule ^bmenu/service/[^\.]*?([^/\.]*)/$ bmenu/service.php?fname=$1 [L,QSA]
RewriteRule ^bmenu/service/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#bmenu/about.php
RewriteRule ^bmenu/about$ "$0/" [R=301,L,QSA]
RewriteRule ^bmenu/about/$ bmenu/about.php [L,QSA]
RewriteRule ^bmenu/about/.*?([^\.\/]*)\.html$ bmenu/about.php?pname=$1 [L,QSA]
RewriteRule ^bmenu/about/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ bmenu/about.php?d=$1$2$3 [L,QSA]
RewriteRule ^bmenu/about/[^\.]*?([^/\.]*)/$ bmenu/about.php?fname=$1 [L,QSA]
RewriteRule ^bmenu/about/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#tax-class.php
RewriteRule ^tax-class$ "$0/" [R=301,L,QSA]
RewriteRule ^tax-class/$ tax-class.php [L,QSA]
RewriteRule ^tax-class/.*?([^\.\/]*)\.html$ tax-class.php?pname=$1 [L,QSA]
RewriteRule ^tax-class/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ tax-class.php?d=$1$2$3 [L,QSA]
RewriteRule ^tax-class/[^\.]*?([^/\.]*)/$ tax-class.php?fname=$1 [L,QSA]
RewriteRule ^tax-class/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#service.php
RewriteRule ^service$ "$0/" [R=301,L,QSA]
RewriteRule ^service/$ service.php [L,QSA]
RewriteRule ^service/.*?([^\.\/]*)\.html$ service.php?pname=$1 [L,QSA]
RewriteRule ^service/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ service.php?d=$1$2$3 [L,QSA]
RewriteRule ^service/[^\.]*?([^/\.]*)/$ service.php?fname=$1 [L,QSA]
RewriteRule ^service/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#product.php
RewriteRule ^product$ "$0/" [R=301,L,QSA]
RewriteRule ^product/$ product.php [L,QSA]
RewriteRule ^product/.*?([^\.\/]*)\.html$ product.php?pname=$1 [L,QSA]
RewriteRule ^product/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ product.php?d=$1$2$3 [L,QSA]
RewriteRule ^product/[^\.]*?([^/\.]*)/$ product.php?fname=$1 [L,QSA]
RewriteRule ^product/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#portfolio.php
RewriteRule ^portfolio$ "$0/" [R=301,L,QSA]
RewriteRule ^portfolio/$ portfolio.php [L,QSA]
RewriteRule ^portfolio/.*?([^\.\/]*)\.html$ portfolio.php?pname=$1 [L,QSA]
RewriteRule ^portfolio/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ portfolio.php?d=$1$2$3 [L,QSA]
RewriteRule ^portfolio/[^\.]*?([^/\.]*)/$ portfolio.php?fname=$1 [L,QSA]
RewriteRule ^portfolio/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#globals.php
RewriteRule ^globals$ "$0/" [R=301,L,QSA]
RewriteRule ^globals/$ globals.php [L,QSA]
RewriteRule ^globals/.*?([^\.\/]*)\.html$ globals.php?pname=$1 [L,QSA]
RewriteRule ^globals/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ globals.php?d=$1$2$3 [L,QSA]
RewriteRule ^globals/[^\.]*?([^/\.]*)/$ globals.php?fname=$1 [L,QSA]
RewriteRule ^globals/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#contact.php
RewriteRule ^contact$ "$0/" [R=301,L,QSA]
RewriteRule ^contact/$ contact.php [L,QSA]
RewriteRule ^contact/.*?([^\.\/]*)\.html$ contact.php?pname=$1 [L,QSA]
RewriteRule ^contact/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ contact.php?d=$1$2$3 [L,QSA]
RewriteRule ^contact/[^\.]*?([^/\.]*)/$ contact.php?fname=$1 [L,QSA]
RewriteRule ^contact/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#blog.php
RewriteRule ^blog$ "$0/" [R=301,L,QSA]
RewriteRule ^blog/$ blog.php [L,QSA]
RewriteRule ^blog/.*?([^\.\/]*)\.html$ blog.php?pname=$1 [L,QSA]
RewriteRule ^blog/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ blog.php?d=$1$2$3 [L,QSA]
RewriteRule ^blog/[^\.]*?([^/\.]*)/$ blog.php?fname=$1 [L,QSA]
RewriteRule ^blog/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#about.php
RewriteRule ^about$ "$0/" [R=301,L,QSA]
RewriteRule ^about/$ about.php [L,QSA]
RewriteRule ^about/.*?([^\.\/]*)\.html$ about.php?pname=$1 [L,QSA]
RewriteRule ^about/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ about.php?d=$1$2$3 [L,QSA]
RewriteRule ^about/[^\.]*?([^/\.]*)/$ about.php?fname=$1 [L,QSA]
RewriteRule ^about/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#index.php
RewriteRule ^.*?([^\.\/]*)\.html$ ?pname=$1 [L,QSA]
RewriteRule ^([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ ?d=$1$2$3 [L,QSA]
RewriteRule ^[^\.]*?([^/\.]*)/$ ?fname=$1 [L,QSA]
RewriteRule ^\w[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]
</IfModule>